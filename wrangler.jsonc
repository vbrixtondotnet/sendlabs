{
  // Sendrix Worker: the API, the daily sender (Cron) and, once deployed, the built app (static assets). The database is PostgreSQL.
  // R2 holds profile pictures (binding PROFILE_PICTURES); Queues are not used. Staging and production declare their own bindings, since environments inherit none.
  "name": "sendrix",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",

  // Only "local" may use the placeholder auth. Every other value makes protected routes answer 503
  // until Cloudflare Access is wired in. Vars are not inherited by environments either.
  "vars": {
    "ENVIRONMENT": "local",
    // The address the BROWSER uses for the app. Locally that is the Vite dev server (it proxies /api to this Worker).
    // Google redirects back to <APP_BASE_URL>/api/sender/gmail/callback, so register that exact address with Google.
    "APP_BASE_URL": "http://localhost:5173"
  },

  // The campaign sender runs every minute. Each run sends a few emails per launched campaign, inside its daily send window
  // and limit (see src/server/services/campaign-sender.ts). Locally, run `wrangler dev --test-scheduled` and open
  // http://localhost:8787/__scheduled, or use POST /api/campaigns/run-tick (local only).
  "triggers": { "crons": ["* * * * *"] },

  // Top level = local development. The database is PostgreSQL on your own machine: the Worker reads its address from
  // DATABASE_URL in .dev.vars (git-ignored; see .dev.vars.example), so there is no database binding here. The PostgreSQL driver
  // needs Node compatibility.
  "compatibility_flags": ["nodejs_compat"],

  // Profile pictures live in a Cloudflare R2 bucket. Locally wrangler simulates it (kept under .wrangler/state), so nothing needs creating.
  // Deployed: `npx wrangler r2 bucket create sendrix-avatars-staging` / `sendrix-avatars-production` (once per environment).
  "r2_buckets": [{ "binding": "PROFILE_PICTURES", "bucket_name": "sendrix-avatars" }],

  // Bindings are NOT inherited by environments, so each one declares its own. In a deployed environment the database is reached
  // through Cloudflare Hyperdrive (a connection pool in front of PostgreSQL). Create one per environment with
  //   npx wrangler hyperdrive create <name> --connection-string "postgresql://USER:PASSWORD@HOST:5432/DATABASE"
  // and put the id it prints in "hyperdrive" below. The connection string itself lives in Hyperdrive, never in this file.
  "env": {
    "staging": {
      "name": "sendrix-staging",
      "vars": { "ENVIRONMENT": "staging", "APP_BASE_URL": "https://REPLACE_WITH_STAGING_URL" },
      "triggers": { "crons": ["* * * * *"] },
      // The deployed Worker serves the built app (run `npm run build` first) as well as /api, so the pages people open from an email,
      // above all /unsubscribe/<token>, load from the same address. Requests under /api/ always go to the Worker; every other
      // address that is not a file falls back to the app (single-page application), where the router takes over.
      "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
      "compatibility_flags": ["nodejs_compat"],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID" }],
      "r2_buckets": [{ "binding": "PROFILE_PICTURES", "bucket_name": "sendrix-avatars-staging" }]
    },
    "production": {
      "name": "sendrix-production",
      "vars": { "ENVIRONMENT": "production", "APP_BASE_URL": "https://sendrix.app", "AUTH_ENABLED": "true" },
      // The app lives at https://sendrix.app. A custom domain makes Cloudflare create the DNS record and the certificate; the
      // domain must be a zone in this Cloudflare account.
      "routes": [{ "pattern": "sendrix.app", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      // The deployed Worker serves the built app (run `npm run build` first) as well as /api, so the pages people open from an email,
      // above all /unsubscribe/<token>, load from the same address. Requests under /api/ always go to the Worker; every other
      // address that is not a file falls back to the app (single-page application), where the router takes over.
      "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
      "compatibility_flags": ["nodejs_compat"],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_ID" }],
      "r2_buckets": [{ "binding": "PROFILE_PICTURES", "bucket_name": "sendrix-avatars-production" }]
    }
  }
}
