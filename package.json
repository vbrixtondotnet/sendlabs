{
  "name": "sendrix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev:api": "node scripts/check-port.mjs 8787",
    "dev:api": "wrangler dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tests && tsc --noEmit -p tests/ui",
    "test": "vitest run",
    "build:templates": "node scripts/build-templates.mjs",
    "seed:local": "tsx scripts/seed-local.ts",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sendrix-db-local --local",
    "db:clear:local": "wrangler d1 execute sendrix-db-local --local --file scripts/clear-local-data.sql",
    "db:seed:tenant:local": "tsx scripts/seed-default-tenant.ts",
    "db:seed:superadmin:local": "tsx scripts/seed-super-admin.ts",
    "db:reset:local": "npm run db:clear:local && npm run db:seed:tenant:local && npm run db:seed:superadmin:local",
    "db:migrate:staging": "wrangler d1 migrations apply sendrix-db-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply sendrix-db-production --remote --env production"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
